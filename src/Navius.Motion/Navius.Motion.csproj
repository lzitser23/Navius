<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <!-- Ship the XML doc file so IDE hover summaries reach package consumers.
         CS1591 (missing doc on a public member) is downgraded to non-blocking:
         the summaries that exist are what we want to surface, not a mandate to
         document every member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Navius.Motion</RootNamespace>
    <PackageId>Navius.Motion</PackageId>
    <Version>0.3.0-preview.1</Version>
    <Authors>Navius contributors</Authors>
    <Description>Standalone Blazor motion primitives and generated CSS for springs, presence, gestures, and layout transitions.</Description>
    <PackageProjectUrl>https://github.com/lzitser23/Navius</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lzitser23/Navius</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>blazor;motion;animation;springs;css</PackageTags>
    <PackageReleaseNotes>Preview release of the Navius motion engine and static web asset stylesheet.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Package validation is intentionally off: these are 0.x pre-1.0 previews with
         no stable baseline to diff against, and a single target framework, so there is
         nothing for it to compare. Re-enable with <PackageValidationBaselineVersion>
         once a stable release exists and API compatibility must be guaranteed. -->
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
